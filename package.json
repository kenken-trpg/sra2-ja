{
  "scripts": {
    "build": "npx vite build",
    "build:public": "npx vite build --outDir public --emptyOutDir false",
    "build:release": "npm run build && node ./tools/release/create-archive.mjs",
    "dev": "npx vite build --outDir public --emptyOutDir false --watch",
    "dev:server": "npx vite serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:check": "npm run typecheck && npm run build",
    "pack:compendiums": "node ./tools/compendium/packCompendiumsToPublic.mjs",
    "unpack:compendiums": "node ./tools/compendium/extractCompendiumsFromPublic.mjs",
    "i18n:scan": "node ./tools/i18n/scan.mjs",
    "i18n:sync": "node ./tools/i18n/sync-ja.mjs",
    "i18n:hardcoded": "node ./tools/i18n/find-hardcoded.mjs",
    "setup:hooks": "sh tools/git-hooks/install.sh",
    "check:i18n": "node ./tools/i18n/compare-locales.mjs --target ja",
    "check:layout": "node ./tools/i18n/layout-risk.mjs --target ja",
    "check:glossary": "node ./tools/i18n/glossary-crossref.mjs",
    "compendium:ja": "node ./tools/compendium/generate-ja.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^2.0.0",
    "@league-of-foundry-developers/foundry-vtt-types": "^v13.345.1",
    "@types/node": "^24.10.0",
    "jsdom": "^30.1.2",
    "less": "^4.4.2",
    "sass": "^1.91.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.4",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "rollup-plugin-visualizer": "^5.12.0",
    "terser": "^5.44.1"
  }
}
